---
# This document is the Lunr.js search index database providing a full
# text search of the page.
#
# See https://lunrjs.com/
layout: null
---
[
{% comment %}
{% for post in site.posts %}
{
"title": {{ post.title | jsonify }},
"url": {{ post.url | absolute_url | jsonify }},
"date": {{ post.date | date: "%B %d, %Y" | jsonify }},
"excerpt": {{ post.excerpt | strip_html | truncatewords: 50 | jsonify }},
"content": {{ post.content | strip_html | truncatewords: 300 | jsonify }},
"description": {{ page.description | jsonify }},
"tags": {{ post.tags | jsonify }},
"categories": {{ post.categories | jsonify }}
},
{% endfor %}
{% endcomment %}

{% assign pages = site.pages | where_exp: "item", "item.layout == 'page'" %}
{% assign pages = pages | where_exp: "item", "item.title != null" %}
{% for page in pages %}
{
"title": {{ page.title | jsonify }},
"url": {{ page.url | absolute_url | jsonify }},
"excerpt": {% capture str %}{% include search-safe-content.liquid content=page.content %}{% endcapture %}{{ str | truncatewords: 50 | jsonify }},
"content": {% capture str %}{% include search-safe-content.liquid content=page.content %}{% endcapture %}{{ str | jsonify }},
"description": {{ page.description | jsonify }}
},
{% endfor %}

{% for page in site.faq %}
{
"title": {{ page.title | jsonify }},
"url": {{ page.url | absolute_url | jsonify }},
"excerpt": {% capture str %}{% include search-safe-content.liquid content=page.content %}{% endcapture %}{{ str | truncatewords: 50 | jsonify }},
"content": {% capture str %}{% include search-safe-content.liquid content=page.content %}{% endcapture %}{{ str | jsonify }},
"description": {{ page.description | jsonify }}
}{% unless forloop.last%},{% endunless %}
{% endfor %}
]
